# Containerfile — Consola CONDOR (Next.js) para auto-alojamiento
# Contexto de build = raíz del repo. Las NEXT_PUBLIC_* se inyectan en build (Next las inlinea).
FROM node:20-bookworm-slim AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
ARG NEXT_PUBLIC_SIM_SUPABASE_URL
ARG NEXT_PUBLIC_SIM_SUPABASE_KEY
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY
ENV NEXT_PUBLIC_SIM_SUPABASE_URL=$NEXT_PUBLIC_SIM_SUPABASE_URL \
    NEXT_PUBLIC_SIM_SUPABASE_KEY=$NEXT_PUBLIC_SIM_SUPABASE_KEY \
    NEXT_PUBLIC_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL \
    NEXT_PUBLIC_SUPABASE_ANON_KEY=$NEXT_PUBLIC_SUPABASE_ANON_KEY \
    NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM node:20-bookworm-slim AS run
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1
COPY --from=build /app/.next ./.next
COPY --from=build /app/public ./public
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/package*.json ./
COPY --from=build /app/next.config.ts ./
EXPOSE 3000
CMD ["npm", "run", "start"]
